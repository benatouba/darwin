{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "darwin.comparison-policy/1",
  "description": "A named, revisioned station-comparison policy. Its exact bytes are pinned by a setups study-requirements/1 operation_recipe; this document alone grants no review or acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "id", "revision", "pairings", "cadences", "completeness", "exclusions", "metrics"],
  "properties": {
    "contract": {"const": "darwin.comparison-policy/1"},
    "id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "pairings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_variable", "model_variable", "observation_field", "units", "kind"],
        "properties": {
          "requirement_variable": {"type": "string", "minLength": 1},
          "model_variable": {"type": "string", "minLength": 1},
          "observation_field": {"type": "string", "minLength": 1},
          "units": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "wet_threshold_mm": {"type": "number", "minimum": 0}
        }
      }
    },
    "cadences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_paired_count", "minimum_paired_fraction"],
      "properties": {
        "minimum_paired_count": {"type": "integer", "minimum": 1},
        "minimum_paired_fraction": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end", "reason"],
        "properties": {
          "start": {"type": "string", "minLength": 1},
          "end": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "histogram_bins": {"type": "integer", "minimum": 1}
  }
}
