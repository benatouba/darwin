{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "darwin-wrf-setups.study-requirements/1",
  "type": "object", "additionalProperties": false,
  "required": ["contract", "id", "revision", "review_status", "sources", "stations", "variables", "operation_recipe", "acceptance"],
  "properties": {
    "contract": {"const": "darwin-wrf-setups.study-requirements/1"},
    "id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "review_status": {"enum": ["draft", "reviewed"]},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identity"}},
    "stations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "variables": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "operation_recipe": {"$ref": "#/$defs/identity"},
    "acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["criteria", "authorized_authorities"],
      "properties": {
        "criteria": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "description", "check", "parameters", "evidence_type"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "description": {"type": "string", "minLength": 1},
              "check": {"type": "string", "minLength": 1},
              "parameters": {"type": "object"},
              "evidence_type": {"type": "string", "minLength": 1}
            }
          }
        },
        "authorized_authorities": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "id", "authorization"],
            "properties": {
              "kind": {"enum": ["reviewer", "policy"]},
              "id": {"type": "string", "minLength": 1},
              "authorization": {"$ref": "#/$defs/identity"}
            }
          }
        }
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"review_status": {"const": "draft"}}},
    "then": {"properties": {"acceptance": {"properties": {"authorized_authorities": {"maxItems": 0}}}}}
  }],
  "$defs": {
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1, "not": {"pattern": "^([Ll][Aa][Tt][Ee][Ss][Tt]|[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Hh][Ee][Aa][Dd])$"}},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
