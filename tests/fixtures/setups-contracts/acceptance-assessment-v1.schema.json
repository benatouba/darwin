{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "darwin-wrf-setups.acceptance-assessment/1",
  "type": "object", "additionalProperties": false,
  "required": ["contract", "id", "dataset", "requirements", "status", "evidence", "authority", "supersedes"],
  "properties": {
    "contract": {"const": "darwin-wrf-setups.acceptance-assessment/1"},
    "id": {"type": "string", "minLength": 1},
    "synthetic": {"type": "boolean"},
    "dataset": {"$ref": "#/$defs/identity"},
    "requirements": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "status": {"enum": ["accepted", "rejected", "unassessed"]},
    "evidence": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterion", "evidence_type", "artifact"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "evidence_type": {"type": "string", "minLength": 1},
          "artifact": {"$ref": "#/$defs/identity"}
        }
      }
    },
    "authority": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "id", "authorization"],
          "properties": {
            "kind": {"enum": ["reviewer", "policy"]},
            "id": {"type": "string", "minLength": 1},
            "authorization": {"$ref": "#/$defs/identity"}
          }
        }
      ]
    },
    "supersedes": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "sha256"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "unassessed"}}},
      "then": {"properties": {"authority": {"type": "null"}}},
      "else": {"properties": {"authority": {"type": "object"}, "evidence": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1, "not": {"pattern": "^([Ll][Aa][Tt][Ee][Ss][Tt]|[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Hh][Ee][Aa][Dd])$"}},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
